# ==========================================
# Frontend Configuration (Next.js)
# ==========================================
# Target URL for backend API calls
NEXT_PUBLIC_API_URL=http://localhost:8000

# Canonical production site domain
NEXT_PUBLIC_SITE_URL=https://pdftools.app

# Monetization & Google AdSense Flags
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# ==========================================
# Backend Configuration (FastAPI)
# ==========================================
PORT=8000
HOST=0.0.0.0

# Privacy & Storage limits
MAX_FILE_SIZE_MB=50
FILE_TTL_MINUTES=15
CLEANUP_INTERVAL_SECONDS=300

# Resource & Concurrency Control (Safe for 2GB RAM VPS)
MAX_CONCURRENT_HEAVY_JOBS=2
JOB_TIMEOUT_SECONDS=60

# Rate Limiting & Security
RATE_LIMIT_PER_MINUTE=60/minute
ALLOWED_ORIGINS=http://localhost:3000,https://pdftools.app
